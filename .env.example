# Konfigurasi Supabase untuk Proyek StafCenter (Akun: ftkstaf@gmail.com)
# Salin file ini menjadi .env.local dan isi dengan URL serta Anon Key dari dashboard Supabase Anda.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Opsional: Identitas Kampus
NEXT_PUBLIC_CAMPUS_NAME="Universitas Nusantara Kampus Terpadu"
NEXT_PUBLIC_APP_ENV="development"
