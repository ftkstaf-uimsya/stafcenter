# Konfigurasi Supabase untuk Proyek StafCenter (Akun: ftkstaf@gmail.com)
# Salin file ini menjadi .env.local dan isi dengan URL serta Keys dari dashboard Supabase Anda.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Wajib untuk Autentikasi Staf, Manajemen Akun Master Admin, dan Sinkronisasi Database via Server
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Opsional: Kunci penandatanganan cookie sesi (minimal 32 karakter acak)
AUTH_SESSION_SECRET=change-this-to-a-long-random-secret-string

# Opsional: Identitas Kampus
NEXT_PUBLIC_CAMPUS_NAME="Universitas Nusantara Kampus Terpadu"
NEXT_PUBLIC_APP_ENV="development"
